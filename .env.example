# ==========================================
# ReviewXpress Environment Configuration
# ==========================================

# 1. Google Gemini AI API Key (Free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase PostgreSQL Database (Optional / Recommended)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Cloudflare Turnstile Anti-Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAExg9IxCReGCFYX3
TURNSTILE_SECRET_KEY=0x4AAAAAAExg9Ku8GF3f20810xdE4xCLirI

# 4. Email Dispatch Engine (Resend - Primary)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ReviewXpress <onboarding@resend.dev>

# 5. Email Dispatch Engine (Gmail SMTP - Fallback)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# 6. Production App URL (Optional, auto-detected on Render)
NEXT_PUBLIC_APP_URL=https://your-custom-domain.in

# 7. Redis High-Speed Cache Engine (Optional / Recommended)
# Supports Render Redis, Upstash Serverless, Redis Cloud, Docker/Local
# Option A: Standard Redis URL
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379
# Option B: Upstash Serverless Redis (HTTP REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

